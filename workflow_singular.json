{
  "name": "SAC - Generar Plantilla Singular",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generar-singular",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a09ce801-f4e5-4b65-9d19-ea326e773f0c",
      "name": "Webhook - Recibir Excel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -960,
        128
      ],
      "webhookId": "singular-excel-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extrae el buffer del Excel recibido como binario o campo de formulario\n// y prepara los parámetros para enviar al servidor.\n\nconst item = $input.first();\n\n// El webhook con binaryData:true guarda archivos en $binary\n// El campo se llama 'excelFile' (multipart form-data)\nconst binaryKey = Object.keys(item.binary || {}).find(\n  k => k === 'excelFile' || k === 'data' || k.endsWith('.xlsx') || k.endsWith('.xls')\n);\n\nif (!binaryKey) {\n  throw new Error(\n    'No se encontró el archivo Excel. Envíe un archivo en el campo \"excelFile\" ' +\n    '(multipart/form-data). Campos binarios disponibles: ' +\n    JSON.stringify(Object.keys(item.binary || {}))\n  );\n}\n\nconst mime = item.binary[binaryKey].mimeType || 'application/octet-stream';\nconst fn   = item.binary[binaryKey].fileName  || 'entrada.xlsx';\n\nreturn [{\n  json: {\n    binaryKey,\n    mimeType:         mime,\n    fileName:         fn,\n    fechaAsignacion:  item.json.body?.fechaAsignacion || '',\n    plantillaPath:    item.json.body?.plantillaPath   || '',\n  },\n  binary: item.binary,\n}];"
      },
      "id": "473c1f5b-0081-45ea-a0be-4aed89a7fb6f",
      "name": "Preparar Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3456/generar-singular",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "excelFile",
              "inputDataFieldName": "={{ $json.binaryKey }}"
            },
            {
              "name": "fechaAsignacion",
              "value": "={{ $json.fechaAsignacion }}"
            },
            {
              "name": "plantillaPath",
              "value": "={{ $json.plantillaPath }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      },
      "id": "075a17de-eef3-4ae4-979e-0cbe919f8abd",
      "name": "HTTP - Generar Singular",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -480,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-ok",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "16532508-d034-476a-a2d7-d6232561cb8d",
      "name": "¿Generación Exitosa?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -240,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Convierte el xlsxBase64 de la respuesta del servidor en un item binario\n// para que el webhook pueda devolverlo como descarga.\n\nconst base64   = $json.xlsxBase64 || '';\nconst clientes = $json.clientes   || [];\nconst errores  = $json.errores    || [];\n\nif (!base64) throw new Error('xlsxBase64 vacío en la respuesta del servidor');\n\nconst mimeType = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';\nconst fileName = `Plantilla_Singular_${new Date().toISOString().slice(0,10)}.xlsx`;\n\nreturn [{\n  json: {\n    success:    true,\n    totalFilas: $json.totalFilas,\n    clientes:   clientes.length,\n    errores:    errores.length,\n    resumen: clientes.map(c =>\n      `${c.cedula} | ${c.nombre} | ${c.cuantia} | ${c.vehiculos} veh. | ${c.correoJuzgado || 'sin correo'}`\n    ).join('\\n'),\n    mimeType,\n    fileName,\n  },\n  binary: {\n    data: {\n      data:     base64,\n      mimeType,\n      fileName,\n    }\n  }\n}];"
      },
      "id": "c0cf8d51-f465-4319-ad1a-dfbd84110548",
      "name": "Convertir a Binario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "binary",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              },
              {
                "name": "Content-Disposition",
                "value": "={{ 'attachment; filename=\"' + $json.fileName + '\"' }}"
              }
            ]
          }
        }
      },
      "id": "fcb8dd8c-e7c2-4705-be34-e3785f5e0f72",
      "name": "Responder con Excel",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: $json.error || 'Error generando Plantilla Singular', errores: $json.errores || [], clientes: $json.clientes || [] }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "a161101e-ef95-49e5-9a02-953e87d33706",
      "name": "Responder con Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        0,
        240
      ]
    }
  ],
