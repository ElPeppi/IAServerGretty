# Copia este archivo a ".env" y rellena los valores.

# Ruta al JSON de la clave del service account (descargado de Google Cloud).
DRIVE_SA_KEY=./sa-key.json

# ID de la Unidad compartida (Shared Drive). Se saca de la URL al abrir la unidad:
#   https://drive.google.com/drive/folders/<ESTE_ID>
DRIVE_SHARED_DRIVE_ID=

# (Opcional) Carpeta dentro de la unidad donde hacer la prueba.
# Si lo dejas vacío, usa la raíz de la Shared Drive.
DRIVE_ROOT_FOLDER_ID=
