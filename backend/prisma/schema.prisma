generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String     // hash bcrypt (login)
  passwordEnc  String?    // copia cifrada reversible (AES) para que el admin pueda verla
  name         String
  role         Role       @default(LAWYER)
  signatureUrl String?
  documents    Document[]
  observaciones Observacion[]
  asignaciones Asignacion[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  LAWYER
}

model Document {
  id          String         @id @default(cuid())
  title       String
  type        String         @default("DEMANDA")
  status      DocumentStatus @default(PENDING)
  fileUrl     String?        // demanda (Word) — panel izquierdo del visor
  signedUrl   String?
  // Anexos generados junto a la demanda — panel derecho del visor
  anexosUrl       String?
  antecedentesUrl String?
  asignacionUrl   String?    // Excel de asignación del que salió la demanda
  poderUrl        String?
  // Notas de procedencia/faltantes: [{ campo, nivel: 'info'|'warning', mensaje }]
  notes       Json?
  clientName  String
  clientRfc   String?
  clientCedula String?
  description String?
  lawyerId    String
  lawyer      User           @relation(fields: [lawyerId], references: [id])
  // Asignación (lote) de la que salió la demanda → enlaza con su poder cacheado.
  asignacionId String?
  asignacion   Asignacion?   @relation(fields: [asignacionId], references: [id])
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  signedAt    DateTime?

  // Índices para que filtros/orden no se degraden al crecer (lista, dashboard, import)
  @@index([lawyerId, createdAt])
  @@index([status])
  @@index([clientCedula])
  @@index([createdAt])
  @@index([asignacionId])
  @@map("documents")
}

// Asignación (lote de clientes de un Excel). Se cachea al subir el Excel o al
// escanear el servidor ("actualizar asignaciones"). Es la base del flujo nuevo:
// subir Excel → generar poderes → generar demandas (reusando el poder).
model Asignacion {
  id              String     @id @default(cuid())
  nombre          String     @unique          // p. ej. "ASIGNACION 11 DE JUNIO DE 2026" (del archivo)
  fechaAsignacion DateTime?                    // fecha de la asignación (valida la antigüedad de los docs)
  excelUrl        String?                      // Excel de asignación en el NAS
  filas           Json                         // filas del Excel cacheadas [{ IDENTIFICACION, NOMBRE, ... }]
  // Mapeo canónico de columnas resuelto por el MOTOR (heurística + Ollama):
  // { IDENTIFICACION: "ID", NOMBRE: "NOMBRE_CLIENTE", ... }. Se guarda por NOMBRE
  // de encabezado y no por índice porque Postgres (jsonb) no conserva el orden
  // original de las claves de `filas`. Null = no se pudo mapear → alias por defecto.
  mapeo           Json?
  totalFilas      Int        @default(0)
  poderUrl        String?                      // Word combinado de poderes EJECUTIVOS SINGULARES
  poderGeneradoAt DateTime?
  // Una misma asignación trae clientes de VARIOS procesos, así que sus poderes de
  // TRÁMITE DE PAGO DIRECTO (garantía mobiliaria) son un Word aparte, con otra
  // plantilla. Se guardan en su propia columna para no pisar los singulares.
  poderPagoDirectoUrl String?
  poderPagoDirectoAt  DateTime?
  correoPoderUrl  String?                      // PDF del correo del banco → ANEXO 1 de la demanda
  docsEnServidor  Boolean    @default(false)   // último estado del checklist global al generar poderes
  lawyerId        String
  lawyer          User       @relation(fields: [lawyerId], references: [id])
  poderes         Poder[]
  documentos      Document[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([lawyerId, createdAt])
  @@map("asignaciones")
}

// Poder cacheado (enlace poder ↔ cliente). Guarda los datos con que se llenó el
// poder la primera vez; al generar la demanda se reconcilian contra la demanda
// (la demanda manda: si difieren nombre/cédula/etc., se corrige el poder).
model Poder {
  id              String     @id @default(cuid())
  asignacionId    String
  asignacion      Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  // Proceso del poder: "SINGULAR" (ejecutivo singular) o "PAGO_DIRECTO" (garantía
  // mobiliaria). Una asignación tiene clientes de ambos; regenerar un tipo solo
  // debe reemplazar los de ESE tipo.
  tipo            String     @default("SINGULAR")
  cedula          String
  nombre          String?
  ciudadJuzgado   String?
  tipoJuzgado     String?
  numeroPagare    String?                      // el Nº que se puso en el poder (docs o OBLIGACION del Excel)
  pagareDesdeDocs Boolean    @default(false)   // true si se leyó del pagaré/DECEVAL del servidor
  // Vehículo dado en garantía (solo PAGO_DIRECTO): es el bien a aprehender.
  placa           String?
  marca           String?
  modelo          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([asignacionId, tipo])
  @@index([cedula])
  @@map("poderes")
}

enum DocumentStatus {
  PENDING
  GENERATED
  SIGNED
  REJECTED
}

// Observación: cliente del Excel para el que NO se generó la demanda y por qué
// (p. ej. "no es DECEVAL ni FINANDINA", "proceso no es ejecutivo singular").
model Observacion {
  id        String   @id @default(cuid())
  cedula    String
  nombre    String?
  motivo    String
  lote      String?  // nombre del Excel/asignación del que provino
  lawyerId  String
  lawyer    User     @relation(fields: [lawyerId], references: [id])
  createdAt DateTime @default(now())

  @@index([lawyerId, createdAt])
  @@index([createdAt])
  @@map("observaciones")
}

// Índice relPath ↔ fileId para el almacenamiento en Google Drive (DriveStorage).
// Drive no tiene rutas: cada archivo se ubica por fileId. Esta tabla evita
// resolver el fileId por API en cada acceso (menos cuota/latencia) y sobrevive
// reinicios. Solo se usa con STORAGE_DRIVER=drive; en modo nas queda vacía.
model DriveFile {
  relPath   String   @id                 // "{cedula}/{nombre}" (posix)
  fileId    String                        // id del archivo en la Shared Drive
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("drive_files")
}

// Datos que el motor NO puede leer del pagaré y se capturan a mano.
// Caso típico: pagaré FINANDINA escaneado — el OCR no lee el número impreso
// (sale el de la OBLIGACION del Excel, que es otro) ni la fecha de suscripción
// manuscrita (queda "#####" en la demanda). Lo que se guarde aquí MANDA sobre
// lo que lea el motor, para esa cédula, en demandas y poderes.
model DatoManual {
  cedula           String   @id
  numeroPagare     String?                 // nº impreso en el pagaré escaneado
  fechaSuscripcion String?                 // DD/MM/YYYY — la manuscrita del pagaré
  nota             String?                 // por qué se corrigió (queda en la traza)
  autorId          String?                 // usuario que lo capturó
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("datos_manuales")
}
