        "jsCode": "// Extrae IDs de adjuntos desde payload.parts del mensaje Gmail completo\nconst payload = $json.payload || {};\nconst messageId = $json.id;\n\n// Cabeceras del mensaje\nconst headers = payload.headers || [];\nconst getHeader = (name) => (headers.find(h => h.name.toLowerCase() === name.toLowerCase()) || {}).value || '';\n\nconst emailFrom    = $json.From || $json.from || getHeader('From') || '';\nconst emailSubject = $json.Subject || $json.subject || getHeader('Subject') || '(sin asunto)'; const decodeB64Url = (d) => d ? Buffer.from(String(d).replace(/-/g,'+').replace(/_/g,'/'),'base64').toString('utf8') : ''; function extraerBody(node){ let text='',html=''; (function walk(part){ if(!part) return; const mt=(part.mimeType||'').toLowerCase(); if(mt==='text/plain'&&part.body&&part.body.data&&!text) text=decodeB64Url(part.body.data); else if(mt==='text/html'&&part.body&&part.body.data&&!html) html=decodeB64Url(part.body.data); if(part.parts) part.parts.forEach(walk); })(node); if(!text&&!html&&node&&node.body&&node.body.data) text=decodeB64Url(node.body.data); return {text,html}; } const _body = extraerBody(payload); const emailBody = _body.text || ''; const emailBodyHtml = _body.html || ''; const emailSnippet = $json.snippet || '';\n\n// Recorre partes recursivamente para encontrar adjuntos reales\nfunction extractAttachments(parts, depth) {\n  if (!parts || depth > 6) return [];\n  const result = [];\n  for (const part of parts) {\n    if (part.filename && part.filename.length > 0 && part.body && part.body.attachmentId) {\n      result.push({\n        attachmentId: part.body.attachmentId,\n        fileName:     part.filename,\n        mimeType:     part.mimeType || 'application/octet-stream'\n      });\n    }\n    if (part.parts) result.push(...extractAttachments(part.parts, depth + 1));\n  }\n  return result;\n}\n\nconst allAttachments = extractAttachments(payload.parts || [], 0);\n\nlet excelAtt = null;\nlet zipAtt   = null;\n\nfor (const att of allAttachments) {\n  const fn = att.fileName.toLowerCase();\n  const mt = att.mimeType.toLowerCase();\n  if (!excelAtt && (fn.endsWith('.xlsx') || fn.endsWith('.xls') || mt.includes('spreadsheet') || mt.includes('excel') || mt.includes('openxmlformats'))) {\n    excelAtt = att;\n  } else if (!zipAtt && (fn.endsWith('.zip') || mt.includes('zip') || mt.includes('x-zip') || mt.includes('compressed'))) {\n    zipAtt = att;\n  }\n}\n\nreturn [{ json: {\n  messageId,\n  emailFrom,\n  emailSubject,\n  emailBody,\n  emailBodyHtml,\n  emailSnippet,\n  hasExcel:          !!excelAtt,\n  hasZip:            !!zipAtt,\n  excelAttachmentId: excelAtt ? excelAtt.attachmentId : '',\n  excelFileName:     excelAtt ? excelAtt.fileName     : '',\n  excelMimeType:     excelAtt ? excelAtt.mimeType     : '',\n  zipAttachmentId:   zipAtt   ? zipAtt.attachmentId   : '',\n  zipFileName:       zipAtt   ? zipAtt.fileName       : '',\n  zipMimeType:       zipAtt   ? zipAtt.mimeType       : ''\n}}];"
      },
